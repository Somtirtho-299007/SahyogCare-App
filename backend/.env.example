# Copy this file to .env and change values as needed. Never commit .env.

# Local development: a SQLite file next to this folder (no database install needed).
SAHYOG_DATABASE_URL=sqlite:///./sahyogcare.db
# Production example (Render / any managed PostgreSQL):
# SAHYOG_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# Frontend addresses allowed to call the API, comma-separated.
SAHYOG_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SAHYOG_ENVIRONMENT=development
# Required in production: a random string of at least 32 characters.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SAHYOG_SECRET_KEY=dev-only-secret-change-me-before-production

# Email for login codes. Leave SAHYOG_SMTP_HOST empty in development:
# codes are then printed in the server terminal and returned as dev_code.
# Gmail example: host smtp.gmail.com, port 587, your address, and an App Password.
SAHYOG_SMTP_HOST=
SAHYOG_SMTP_PORT=587
SAHYOG_SMTP_USER=
SAHYOG_SMTP_PASSWORD=
SAHYOG_SMTP_FROM=SahyogCare <no-reply@sahyogcare.test>
